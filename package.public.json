{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx lerna run dev --scope=@react-form-builder/example-viewer",
    "build": "npx lerna run build",
    "pack": "npx lerna run pack",
    "clean": "lerna exec -- npx rimraf node_modules dist build *.tgz && rimraf node_modules",
    "check:tsc": "tsc --noEmit --emitDeclarationOnly false",
    "eslint": "npx eslint .",
    "eslint-fix": "npx eslint . --fix"
  },
  "workspaces": [
    "scripts/cli-lib",
    "packages/*",
    "packages/apps/*",
    "packages/views/*"
  ],
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/typescript-estree": "8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsdoc": "65.4.3",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "3.4.0",
    "eslint-plugin-unicorn": "79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lerna": "^10.1.1",
    "lightningcss": "^1.29.1",
    "npm-run-all2": "^9.0.2",
    "playwright": "1.65.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-exclude-dependencies-from-bundle": "^1.1.24",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.6",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
