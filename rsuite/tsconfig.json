{
  "compilerOptions": {
    "noImplicitAny": false,
    "module": "commonjs",
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es5",
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "esModuleInterop": false
  },
  "exclude": [
    "node_modules"
  ]
}
