{
    "name": "root",
    "private": true,
    "type": "module",
    "scripts": {
        "graph": "npx nx graph",
        "show:bundle": "npx lerna run show:bundle --scope=example-builder",
        "bootstrap": "npx lerna bootstrap",
        "build": "npx lerna run build --ignore fb-docs",
        "start": "npx lerna run start --scope=example-builder",
        "dev:builder": "npx lerna run start --scope=example-builder",
        "dev:viewer": "npx lerna run start --scope=example-viewer",
        "docs:start": "npx lerna run start --scope=fb-docs",
        "docs:build": "npx lerna run build --scope=fb-docs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:related": "vitest related",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "check:circular-deps": "npx madge --extensions ts --circular ."
    },
    "workspaces": [
        "packages/*",
        "packages/apps/*",
        "packages/views/*",
        "documentation/website"
    ],
    "dependencies": {
        "react": "^17.0.2",
        "react-dom": "^17.0.2"
    },
    "devDependencies": {
        "@faker-js/faker": "^7.5.0",
        "@swc/plugin-emotion": "^2.5.57",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^12.1.5",
        "@testing-library/user-event": "^14.4.3",
        "@types/react": "^17.0.54",
        "@types/react-dom": "^17.0.19",
        "@vitejs/plugin-react-swc": "^3.2.0",
        "@vitest/coverage-c8": "^0.29.7",
        "@vitest/ui": "^0.29.7",
        "c8": "^7.13.0",
        "jsdom": "^20.0.3",
        "lerna": "^5.5.2",
        "nx": "^14.7.17",
        "typescript": "^5.0.3",
        "vite": "^4.2.1",
        "vite-bundle-visualizer": "^0.6.0",
        "vitest": "^0.29.7",
        "vitest-fail-on-console": "^0.3.1"
    }
}
