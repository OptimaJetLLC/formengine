{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "show:bundle": "npx lerna run --stream show:bundle --scope=@react-form-builder/example-builder",
    "build": "npx lerna run --stream build --ignore @react-form-builder/docs",
    "build:ci": "node ./scripts/build-with-concurrency.ts",
    "build:check-build:ci": "node ./scripts/build-apps-and-views-with-concurrency.ts",
    "pack": "npx lerna run --stream pack --ignore @react-form-builder/docs",
    "pack:ci": "node ./scripts/pack-with-concurrency.ts",
    "start": "npx lerna run --stream start --scope=@react-form-builder/example-builder",
    "demo:build": "npx lerna run --stream build --scope=@react-form-builder/demo",
    "demo:start": "npx lerna run --stream start --scope=@react-form-builder/demo",
    "demo:serve": "npx lerna run --stream serve --scope=@react-form-builder/demo",
    "dev:builder": "npx lerna run --stream dev --scope=@react-form-builder/example-builder",
    "start:builder": "npx lerna run --stream start --scope=@react-form-builder/example-builder",
    "dev:viewer": "npx lerna run --stream dev --scope=@react-form-builder/example-viewer",
    "start:viewer": "npx lerna run --stream start --scope=@react-form-builder/example-viewer",
    "docs:start": "npx lerna run --stream start --scope=@react-form-builder/docs",
    "docs:build": "npx lerna run --stream build --scope=@react-form-builder/docs",
    "docs:serve": "npx lerna run --stream serve --scope=@react-form-builder/docs",
    "designer-guide:dev": "npm run dev --prefix designer-guide",
    "designer-guide:build": "npm run build --prefix designer-guide",
    "designer-guide:preview": "npm run preview --prefix designer-guide",
    "designer-guide:clean": "npm run clean --prefix designer-guide",
    "designer-guide:screenshots": "node skills/formbuilder-end-user-docs/scripts/capture-all-guide-screenshots.mjs && npm run optimize:images --prefix designer-guide",
    "docs:generate-bundles": "node ./scripts/generate-doc-bundles.ts",
    "archives:build": "earthly --ci --output +prepare-all-archives && earthly --ci --output +prepare-documentation-sites-archives",
    "archives:build:from-pack": "earthly --ci --output +prepare-rc-archives-from-pack && earthly --ci --output +prepare-documentation-sites-archives",
    "simulate:ci-rc-release": "bash scripts/simulate-ci-rc-release.sh",
    "generate:changelog": "node ./scripts/generate-changelog.ts",
    "generate:github-release-notes": "node ./scripts/generate-github-release-notes.ts",
    "generate-mantine-form": "node ./scripts/generate-mantine-form.ts",
    "create-json-schema": "npx lerna run --stream create-json-schema",
    "test": "npx lerna run --stream test",
    "test:module": "npx lerna run --stream test:module",
    "test:component": "npx lerna run --stream test:component --concurrency=1",
    "test:browser": "npx lerna run --stream test:browser --concurrency=1",
    "test:e2e": "npx lerna run --stream test:e2e --scope=@react-form-builder/tests-e2e",
    "clean": "lerna exec -- npx rimraf node_modules dist build && rimraf node_modules",
    "check:dist": "lerna run --stream check:dist",
    "check-all": "npm-run-all -l check:circular-deps check:tsc check:unused-exports check:eslint check:format check:stylelint check:docs-mdx check:distribution-package-json check:license-expiry",
    "check:stylelint": "npm run check:stylelint --prefix designer-guide",
    "check:circular-deps": "npx madge@8.0.0 --extensions ts,tsx --circular .",
    "check:tsc": "tsc --noEmit --emitDeclarationOnly false && npm run check:tsc --prefix designer-guide",
    "check:unused-exports": "knip --include exports,types,nsExports,nsTypes --exclude dependencies,files,unlisted,binaries,unresolved,catalog,duplicates,enumMembers,namespaceMembers",
    "check:eslint": "npm run eslint && npm run check:eslint --prefix designer-guide",
    "eslint": "npx eslint .",
    "eslint-fix": "npx eslint . --fix",
    "format": "npx biome check . --write",
    "check:format": "npx biome check .",
    "check:docs-mdx": "npx mdxlint documentation/docs designer-guide --ext .md,.mdx --frail -S",
    "check:cross-site-docs-links": "node ./documentation/website/scripts/check-cross-site-links.ts",
    "check:docs-broken-images": "node ./documentation/website/scripts/check-broken-images.ts",
    "check:package": "npx lerna exec -- npx @e18e/cli analyze",
    "check:licenses": "node ./scripts/check-licenses.ts",
    "check:license-expiry": "node ./scripts/check-license-expiry.ts",
    "check:distribution-package-json": "node ./scripts/check-distribution-package-json.ts",
    "sync:distribution-package-json": "node ./scripts/sync-distribution-package-json.ts",
    "version-update": "node ./scripts/version-update.ts",
    "examples:install-local-packages": "node ./scripts/examples-install-local-packages.ts",
    "todo": "npx leasot '(packages|tests|types|examples|documentation)/**/*.(ts|tsx|js)' -S --ignore '**/node_modules,**/dist'",
    "postinstall": "git rev-parse --git-dir >/dev/null 2>&1 && npx lefthook install || true"
  },
  "workspaces": [
    "packages/*",
    "packages/apps/*",
    "packages/views/*",
    "documentation/website",
    "designer-guide",
    "tests/*",
    "scripts/cli-lib"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-form-builder/cli-lib": "*",
    "@types/node": "^24.12.0",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript-eslint/typescript-estree": "8.71.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.4.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.39.0",
    "leasot": "^14.4.0",
    "lefthook": "^2.1.9",
    "lerna": "^9.0.1",
    "lightningcss": "^1.29.1",
    "madge": "^8.0.0",
    "mdxlint": "^1.0.0",
    "npm-run-all2": "^9.0.2",
    "playwright": "1.64.1",
    "remark-custom-heading-id": "^2.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^5.0.0",
    "rollup-plugin-exclude-dependencies-from-bundle": "^1.1.24",
    "typescript": "5.8.3",
    "vite": "^7.2.6",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-cp": "^6.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "typescript": "5.8.3"
  }
}
