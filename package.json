{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "graph": "npx nx graph",
    "show:bundle": "npx lerna run show:bundle --scope=@react-form-builder/example-builder",
    "bootstrap": "npx lerna bootstrap",
    "build": "npx lerna run build --ignore @react-form-builder/docs",
    "bundle": "npx lerna run bundle --ignore @react-form-builder/docs",
    "start": "npx lerna run start --scope=@react-form-builder/example-builder",
    "demo:build": "npx lerna run build --scope=@react-form-builder/demo",
    "demo:start": "npx lerna run start --scope=@react-form-builder/demo",
    "demo:serve": "npx lerna run serve --scope=@react-form-builder/demo",
    "dev:builder": "npx lerna run dev --scope=@react-form-builder/example-builder",
    "start:builder": "npx lerna run start --scope=@react-form-builder/example-builder",
    "dev:viewer": "npx lerna run dev --scope=@react-form-builder/example-viewer",
    "start:viewer": "npx lerna run start --scope=@react-form-builder/example-viewer",
    "docs:start": "npx lerna run start --scope=@react-form-builder/docs",
    "docs:build": "npx lerna run build --scope=@react-form-builder/docs",
    "test": "npx lerna run test",
    "test:module": "npx lerna run test:module",
    "test:component": "npx lerna run test:component",
    "test:e2e": "npx lerna run test:e2e --scope=@react-form-builder/tests-e2e",
    "clean": "lerna exec -- npx rimraf node_modules dist build && rimraf node_modules",
    "check:circular-deps": "npx madge@6.1.0 --extensions ts --circular .",
    "check:tsc": "tsc --noEmit --emitDeclarationOnly false",
    "check:unused-exports": "node ./scripts/find-unused-exports",
    "check:wrong-imports": "node ./scripts/find-wrong-imports",
    "eslint": "npx eslint .",
    "eslint-fix": "npx eslint . --fix",
    "todo": "npx leasot '(packages|tests|sample-apps|tools|types|examples|documentation)/**/*.(ts|tsx|js)' -S --ignore '**/node_modules'"
  },
  "workspaces": [
    "packages/*",
    "packages/apps/*",
    "packages/views/*",
    "documentation/website",
    "tests/*"
  ],
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/ui": "^2.1.8",
    "cross-env": "^7.0.3",
    "eslint": "^8.41.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-no-secrets": "^1.0.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^2.0.0",
    "fs-extra": "^11.1.1",
    "jsdom": "^26.0.0",
    "klona": "^2.0.6",
    "leasot": "^14.4.0",
    "lerna": "^5.6.2",
    "npm-run-all": "^4.1.5",
    "nx": "^14.7.17",
    "rimraf": "^5.0.0",
    "rollup-plugin-exclude-dependencies-from-bundle": "^1.1.23",
    "ts-prune": "^0.10.3",
    "typescript": "^5.0.3",
    "vite": "^4.5.9",
    "vite-bundle-analyzer": "^0.10.3",
    "vite-plugin-cp": "^4.0.8",
    "vite-plugin-dts": "^3.6.1",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^2.1.8",
    "vitest-fail-on-console": "^0.7.1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3"
  }
}
