{
    "name": "root",
    "private": true,
    "type": "module",
    "scripts": {
        "graph": "npx nx graph",
        "show:bundle": "npx lerna run show:bundle --scope=@react-form-builder/example-builder",
        "bootstrap": "npx lerna bootstrap",
        "build": "npx lerna run build --ignore @react-form-builder/docs",
        "bundle": "npx lerna run bundle --ignore @react-form-builder/docs",
        "start": "npx lerna run start --scope=@react-form-builder/example-builder",
        "demo:build": "npx lerna run build --scope=@react-form-builder/demo",
        "demo:start": "npx lerna run start --scope=@react-form-builder/demo",
        "demo:serve": "npx lerna run serve --scope=@react-form-builder/demo",
        "dev:builder": "npx lerna run start --scope=@react-form-builder/example-builder",
        "dev:viewer": "npx lerna run start --scope=@react-form-builder/example-viewer",
        "docs:start": "npx lerna run start --scope=@react-form-builder/docs",
        "docs:build": "npx lerna run build --scope=@react-form-builder/docs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:related": "vitest related",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "check:circular-deps": "npx madge@6.1.0 --extensions ts --circular .",
        "check:tsc": "tsc --noEmit --emitDeclarationOnly false",
        "check:unused-exports": "node ./scripts/find-unused-exports",
        "check:wrong-imports": "node ./scripts/find-wrong-imports",
        "eslint": "npx eslint .",
        "eslint-fix": "npx eslint . --fix"
    },
    "workspaces": [
        "packages/*",
        "packages/apps/*",
        "packages/views/*",
        "documentation/website"
    ],
    "devDependencies": {
        "@faker-js/faker": "^7.5.0",
        "@svgr/rollup": "^8.0.1",
        "@swc/plugin-emotion": "^2.5.57",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^12.1.5",
        "@testing-library/user-event": "^14.4.3",
        "@types/react": "^17.0.54",
        "@types/react-dom": "^17.0.19",
        "@typescript-eslint/eslint-plugin": "^5.59.7",
        "@typescript-eslint/parser": "^5.59.7",
        "@vitejs/plugin-react-swc": "^3.2.0",
        "@vitest/coverage-c8": "^0.29.7",
        "@vitest/ui": "^0.29.7",
        "c8": "^7.13.0",
        "eslint": "^8.41.0",
        "eslint-import-resolver-typescript": "^3.5.5",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-jsdoc": "^46.8.2",
        "eslint-plugin-unused-imports": "^2.0.0",
        "fs-extra": "^11.1.1",
        "jsdom": "^20.0.3",
        "lerna": "^5.5.2",
        "npm-run-all": "^4.1.5",
        "nx": "^14.7.17",
        "rimraf": "^5.0.0",
        "rollup-plugin-exclude-dependencies-from-bundle": "^1.1.23",
        "ts-prune": "^0.10.3",
        "typescript": "^5.0.3",
        "vite": "^4.2.1",
        "vite-bundle-visualizer": "^0.6.0",
        "vite-plugin-dts": "^3.6.1",
        "vite-plugin-svgr": "^3.2.0",
        "vitest": "^0.29.7",
        "vitest-fail-on-console": "^0.3.1"
    }
}
