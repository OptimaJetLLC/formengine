{
  "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
  "vcs": {
    "enabled": true,
    "defaultBranch": "master",
    "useIgnoreFile": true,
    "clientKind": "git"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,jsx,json,css,md}",
      "packages/views/rsuite/config/**/*",
      "packages/views/rsuite/vite.config.ts",
      "packages/views/material-ui/config/*",
      "packages/views/material-ui/vite.config.ts",
      "!**/rsuite-no-reset*.css",
      "!**/formengine-rsuite.css",
      "packages/apps/**/*.{ts,tsx}",
      "packages/designer-bundle/**/*.{ts,tsx}",
      "packages/indexed-db-form-storage/**/*.{ts,tsx}",
      "packages/viewer-bundle/**/*.{ts,tsx}",
      "packages/viewer-bundle-premium/**/*.{ts,tsx}",
      "scripts/**/*.ts",
      "!documentation/website/static"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": false,
    "bracketSameLine": false
  },
  "linter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "expand": "always"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "bracketSameLine": false,
      "attributePosition": "auto"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
