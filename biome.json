{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "defaultBranch": "master",
    "useIgnoreFile": true,
    "clientKind": "git"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,jsx,json,css,md}",
      "packages/**/*.{ts,tsx,mjs,json,md}",
      "examples/**/*.{ts,tsx,mjs,json,md}",
      "tests/**/*.{ts,tsx,mjs,json,md}",
      "!**/rsuite-no-reset*.css",
      "!**/formengine-rsuite.css",
      "scripts/**/*.{ts,mjs,json,md}",
      "!documentation/website/static",
      "!documentation/docs/api-reference/**",
      "!documentation/docs/components-library/material-ui/index.md",
      "!documentation/docs/components-library/mantine/index.md",
      "!documentation/docs/formengine-core/installation.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": false,
    "bracketSameLine": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "useSingleJsDocAsterisk": "error"
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "expand": "always"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "bracketSameLine": false,
      "attributePosition": "auto"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/src/features/annotation/fnAnnotation.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useSingleJsDocAsterisk": "off"
          }
        }
      }
    }
  ],
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "formatEmbeds": false
    }
  }
}
