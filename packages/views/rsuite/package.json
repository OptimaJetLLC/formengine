{
    "name": "@react-form-builder/components-rsuite",
    "version": "0.0.0",
    "private": false,
    "main": "src/index.ts",
    "type": "module",
    "description": "OptimaJet Form Builder Components - RSuite",
    "license": "ISC",
    "scripts": {
        "build": "vite build",
        "clean": "rimraf dist temp",
        "clean-typings": "rimraf dist/types src/tsdoc-metadata.json temp",
        "generate-typings": "tsc --build bundle.tsconfig.json",
        "api-extractor": "api-extractor run --local --verbose",
        "bundle": "npm-run-all -l clean build generate-typings clean-typings create-archive",
        "create-archive": "node ./config/pack"
    },
    "peerDependencies": {
        "@emotion/css": "^11.10.5",
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@react-form-builder/builder": "^0.0.0",
        "@rsuite/icons": "^1.0.2",
        "react": ">=17.0.2 || ^18",
        "react-number-format": "^5.1.4",
        "rsuite": "^5.31.1"
    },
    "files": [
        "dist/*"
    ]
}
