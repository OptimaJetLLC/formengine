    "scripts": {
        "build": "vite build",
        "clean": "rimraf dist temp",
        "clean-typings": "rimraf dist/types dist/tsdoc-metadata.json temp",
        "generate-typings": "tsc --build bundle.tsconfig.json",
        "api-extractor": "api-extractor run --local --verbose",
        "bundle": "npm-run-all -l clean build generate-typings api-extractor clean-typings create-archive",
        "create-archive": "node ./config/pack"
    },
    "peerDependencies": {
        "@emotion/cache": "^11.10.5",
        "@emotion/css": "^11.10.5",
