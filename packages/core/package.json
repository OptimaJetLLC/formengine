        "mobx": "^6.9.0",
        "mobx-react": "^7.3.0",
        "react": ">=17.0.2 || ^18",
        "react-dom": ">=17.0.2 || ^18",
        "rxjs": "^7.8.0",
        "stylis-plugin-rtl": "^2.1.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.7"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
