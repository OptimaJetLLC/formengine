{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "es5",
        "module": "es6",
        "jsx": "react",
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "moduleResolution": "Node",
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules"
    ]
}
