{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "es5",
        "lib": [
        "dom",
        "dom.iterable",
        "esnext"
        ],
        "module": "esnext",
        "jsx": "react",
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "moduleResolution": "Node",
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules"
    ]
}
