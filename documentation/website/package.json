{
  "name": "@react-form-builder/docs",
  "version": "11.1.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "generate-typedoc": "dotenv -v ENABLE_TYPEDOC=\"true\" docusaurus build",
    "copy-bundle-charts": "node scripts/copy-bundle-charts.ts",
    "compress-all-images": "node scripts/compress-images.ts ./static",
    "compress-changed-images": "(git diff --name-only --relative -z master -- 'static/**/*.jpg' 'static/**/*.jpeg' 'static/**/*.png' 'static/**/*.gif' || true; git ls-files --others --exclude-standard -z -- 'static/**/*.jpg' 'static/**/*.jpeg' 'static/**/*.png' 'static/**/*.gif' || true) | xargs -0 -r -n1 node scripts/compress-images.ts",
    "compress-image": "node scripts/compress-images.ts",
    "postbuild": "node scripts/fix-llms-links.ts"
  },
  "dependencies": {
    "@docsearch/core": "^5.1.2",
    "@docsearch/css": "^5.1.2",
    "@docsearch/docusaurus-adapter": "^5.1.2",
    "@docsearch/react": "^5.1.2",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-live-codeblock": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@react-form-builder/components-mantine": "file:packages/react-form-builder-components-mantine.tgz",
    "@react-form-builder/components-material-ui": "file:packages/react-form-builder-components-material-ui.tgz",
    "@react-form-builder/components-rsuite": "file:packages/react-form-builder-components-rsuite.tgz",
    "@react-form-builder/components-rsuite-table": "file:packages/react-form-builder-components-rsuite-table.tgz",
    "@react-form-builder/components-uploader": "file:packages/react-form-builder-components-uploader.tgz",
    "@react-form-builder/core": "file:packages/react-form-builder-core.tgz",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.1.1",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-live": "^5.0.1",
    "react-vega": "^8.0.0",
    "rsuite": "^5.83.4",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "cross-env": "^10.1.0",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.35.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "5.8.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
