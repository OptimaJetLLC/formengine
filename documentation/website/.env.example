# Form Author Guide base URL (path on same host or absolute URL).
# Defaults to https://learn.formengine.io/ when unset.
# Local Caddy: https://learn.formengine.local/
# Direct Astro: http://localhost:4321/
# Examples:
#   DESIGNER_GUIDE_URL=https://learn.formengine.io/
#   DESIGNER_GUIDE_URL=http://localhost:4321/
DESIGNER_GUIDE_URL=https://learn.formengine.local/

# Main developer documentation base (used by Docusaurus tooling that links out; Form Author Guide
# uses the same variable name when rewriting `docs:…` links - set it in designer-guide/.env too).
# MAIN_DOCS_URL=/documentation
