{
  "name": "@react-form-builder/test-react-19",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
    "start:designer": "vite --port=15002 -c designer.vite.config.ts",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:debug": "vitest run -- --test-timeout=0 --no-file-parallelism --inspect-brk",
    "test:browser": "npm run test -- --browser",
    "test:browser:debug": "dotenv -v BROWSER_DEVTOOL=1 npm run test:browser -- -- --inspectBrk --no-file-parallelism",
    "test:browser:headless": "npm run test -- --browser.headless",
    "test:component": "npm run test"
  },
  "dependencies": {
    "@react-form-builder/components-antd": "^3.6.0",
    "@react-form-builder/components-fast-qr": "^3.6.0",
    "@react-form-builder/components-google-map": "^3.6.0",
    "@react-form-builder/components-rich-text": "^3.6.0",
    "@react-form-builder/components-rsuite": "^3.6.0",
    "@react-form-builder/core": "^3.6.0",
    "@react-form-builder/designer": "^3.6.0",
    "@react-form-builder/indexed-db-form-storage": "^3.6.0",
    "@react-form-builder/tests-common": "file:./../common",
    "@react-form-builder/tests-component": "file:./../component",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "skia-canvas": "^2.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "jsdom": "^26.0.0"
  }
}
