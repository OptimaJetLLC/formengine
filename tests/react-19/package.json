{
  "name": "@react-form-builder/test-react-19",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "author": "Optimajet",
  "homepage": "https://formengine.io/",
  "scripts": {
    "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
    "start:designer": "vite --port=15002 -c designer.vite.config.ts",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:debug": "vitest run --test-timeout=0 --no-file-parallelism --inspect-brk",
    "test:browser": "dotenv -v VITEST_CHROMIUM_GC_FORCE=1 -v VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=500 -- npm run test -- --browser",
    "test:browser:debug": "dotenv -v BROWSER_DEVTOOL=1 -- npm run test:browser -- --inspectBrk --no-file-parallelism",
    "test:browser:headless": "npm run test:browser -- --browser.headless",
    "test:component": "npm run test",
    "test:ui": "vitest --ui",
    "test:browser:ui": "dotenv -v VITEST_CHROMIUM_GC_FORCE=1 -v VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=500 -- vitest --ui --browser.headless"
  },
  "dependencies": {
    "@react-form-builder/tests-common": "file:./../common",
    "@react-form-builder/tests-component": "file:./../component"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0"
  }
}
