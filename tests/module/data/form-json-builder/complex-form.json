                    {
                      "key": "required"
                    }
                  ]
                }
              },
              {
                "key": "password",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Password"
                  },
                  "passwordMask": {
                    "value": true
                  }
                },
                "schema": {
                  "validations": [
                    {
                      "key": "required"
                    }
                  ]
                }
              }
            ]
          },
          {
            "key": "submit",
            "type": "RsButton",
            "props": {
              "children": {
