          }
        },
        "events": {
          "onClick": [
            {
              "name": "openModal",
              "type": "common",
              "args": {
                "modalKey": "modal1",
                "beforeShow": {
                  "type": "fn",
                  "body": "  if (e.data.modalInput === 'no') return false\n  return {modalInput: \"modal input data from beforeShow\"}"
                }
              }
            }
          ]
        },
        "htmlAttributes": [
          {
            "name": "data-testid",
            "value": "showModalButton"
          }
        ]
      }
    ]
  },
  "localization": {},
  "languages": [
    {
      "code": "en",
      "dialect": "US",
      "name": "English",
      "description": "American English",
      "bidi": "ltr"
