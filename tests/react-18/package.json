{
    "name": "@react-form-builder/test-react-18",
    "version": "3.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
        "start:designer": "vite --port=15002 -c designer.vite.config.ts",
        "clean": "rimraf dist",
        "test": "dotenv -v NODE_OPTIONS=\"-r ./require.cjs\" vitest run",
        "test:component": "npm run test",
        "test:dbg": "dotenv -v NODE_OPTIONS=\"-r ./require.cjs\" vitest run --ui --open --inspectBrk --no-file-parallelism"
    },
    "dependencies": {
        "@react-form-builder/components-antd": "^3.2.0",
        "@react-form-builder/components-fast-qr": "^3.2.0",
        "@react-form-builder/components-google-map": "^3.2.0",
        "@react-form-builder/components-rich-text": "^3.2.0",
        "@react-form-builder/components-rsuite": "^3.2.0",
        "@react-form-builder/core": "^3.2.0",
        "@react-form-builder/designer": "^3.2.0",
        "@react-form-builder/indexed-db-form-storage": "^3.2.0",
        "@react-form-builder/tests-common": "file:./../common",
        "@react-form-builder/tests-component": "file:./../component",
        "canvas": "^3.1.0",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^18.3.18",
        "@types/react-dom": "18.3.5",
        "jsdom": "^26.0.0"
    }
