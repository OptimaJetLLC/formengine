{
  "name": "@react-form-builder/test-react-18",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "author": "Optimajet",
  "homepage": "https://formengine.io/",
  "scripts": {
    "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
    "start:designer": "vite --port=15002 -c designer.vite.config.ts",
    "clean": "rimraf dist",
    "test": "dotenv -v NODE_OPTIONS=\"-r ./require.cjs\" vitest run",
    "test:debug": "dotenv -v NODE_OPTIONS=\"-r ./require.cjs\" vitest run -- --test-timeout=0 --no-file-parallelism --inspect-brk",
    "test:browser": "npm run test -- -- --browser",
    "test:browser:debug": "dotenv -v BROWSER_DEVTOOL=1 npm run test:browser -- -- --inspectBrk --no-file-parallelism",
    "test:browser:headless": "npm run test -- -- --browser.headless",
    "test:component": "npm run test"
  },
  "dependencies": {
    "@react-form-builder/components-antd": "^4.1.0",
    "@react-form-builder/components-fast-qr": "^4.1.0",
    "@react-form-builder/components-google-map": "^4.1.0",
    "@react-form-builder/components-rich-text": "^4.1.0",
    "@react-form-builder/components-rsuite": "^4.1.0",
    "@react-form-builder/core": "^4.1.0",
    "@react-form-builder/designer": "^4.1.0",
    "@react-form-builder/indexed-db-form-storage": "^4.1.0",
    "@react-form-builder/tests-common": "file:./../common",
    "@react-form-builder/tests-component": "file:./../component",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "skia-canvas": "^2.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "^26.0.0"
  }
}
