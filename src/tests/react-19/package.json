{
  "name": "@react-form-builder/test-react-19",
  "version": "7.11.0",
  "private": true,
  "type": "module",
  "author": "Optimajet",
  "homepage": "https://formengine.io/",
  "scripts": {
    "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
    "start:designer": "vite --port=15002 -c designer.vite.config.ts",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:debug": "vitest run --test-timeout=0 --no-file-parallelism --inspect-brk",
    "test:browser": "npm run test -- --browser",
    "test:browser:debug": "dotenv -v BROWSER_DEVTOOL=1 npm run test:browser -- -- --inspectBrk --no-file-parallelism",
    "test:browser:headless": "npm run test -- --browser.headless",
    "test:component": "npm run test",
    "test:ui": "vitest --ui",
    "test:browser:ui": "vitest --ui --browser"
  },
  "dependencies": {
    "@react-form-builder/components-antd": "^7.11.0",
    "@react-form-builder/components-fast-qr": "^7.11.0",
    "@react-form-builder/components-google-map": "^7.11.0",
    "@react-form-builder/components-material-ui": "^7.11.0",
    "@react-form-builder/components-rich-text": "^7.11.0",
    "@react-form-builder/components-rsuite": "^7.11.0",
    "@react-form-builder/core": "^7.11.0",
    "@react-form-builder/designer": "^7.11.0",
    "@react-form-builder/indexed-db-form-storage": "^7.11.0",
    "@react-form-builder/tests-common": "file:./../common",
    "@react-form-builder/tests-component": "file:./../component",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "jsdom": "^27.2.0"
  }
}
