{
  "name": "@react-form-builder/test-react-17",
  "version": "5.2.0",
  "private": true,
  "type": "module",
  "author": "Optimajet",
  "homepage": "https://formengine.io/",
  "scripts": {
    "start:viewer": "vite --port=15001 -c viewer.vite.config.ts",
    "start:designer": "vite --port=15002 -c designer.vite.config.ts",
    "clean": "rimraf dist",
    "test": "dotenv -v NODE_OPTIONS=\"--loader ./import.js -r ./require.cjs\" vitest run",
    "test:debug": "dotenv -v NODE_OPTIONS=\"--loader ./import.js -r ./require.cjs\" vitest run -- --test-timeout=0 --no-file-parallelism --inspect-brk",
    "test:component": "npm run test"
  },
  "dependencies": {
    "@react-form-builder/components-antd": "^5.2.0",
    "@react-form-builder/components-fast-qr": "^5.2.0",
    "@react-form-builder/components-google-map": "^5.2.0",
    "@react-form-builder/components-rich-text": "^5.2.0",
    "@react-form-builder/components-rsuite": "^5.2.0",
    "@react-form-builder/core": "^5.2.0",
    "@react-form-builder/designer": "^5.2.0",
    "@react-form-builder/indexed-db-form-storage": "^5.2.0",
    "@react-form-builder/tests-common": "file:./../common",
    "@react-form-builder/tests-component": "file:./../component",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "skia-canvas": "^2.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^8.20.1",
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/react": "^12.1.5",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.26"
  }
}
