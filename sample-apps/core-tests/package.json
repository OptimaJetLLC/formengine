{
  "name": "core-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Test applications for @react-form-builder/core package tree-shaking verification",
  "scripts": {
    "build:lite": "cd test-app-lite && vite build",
    "build:full": "cd test-app-full && vite build",
    "build:all": "npm run build:lite && npm run build:full",
    "build": "npm run build:all",
    "test:lite": "node scripts/test-lite.ts",
    "test:full": "node scripts/test-full.ts",
    "test:all": "node scripts/test-all.ts",
    "test": "npm run test:all",
    "clean": "rm -rf ./dist"
  },
  "dependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.23",
    "@types/react-dom": "^18.2.8",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^7.1.4",
    "vite-bundle-analyzer": "^1.2.3"
  }
}
