# Site URL for sitemap, robots.txt, and meta tags.
# Default: https://learn.formengine.io
# Examples:
#   SITE_URL=https://learn.formengine.io
#   SITE_URL=https://formengine.io/guide
# SITE_URL=https://learn.formengine.io

# Main developer documentation base URL (path on same host or absolute URL).
# Used when rewriting `docs:…` links and header/footer “Developer docs” links.
# Default when unset: https://formengine.io/documentation/
# Examples:
#   MAIN_DOCS_URL=/documentation
#   MAIN_DOCS_URL=https://formengine.io/documentation
#   MAIN_DOCS_URL=https://docs.example.com
# MAIN_DOCS_URL=https://formengine.io/documentation

# FormEngine demo deep-link base (Try it tips, header Demo, footer Form Builder Demo).
# Markdown keeps https://demo.formengine.io/; Astro rewrites at build/dev time.
#
# Set DEMO_URL in `.env`, `.env.local`, or the environment. `.env.development` does not
# override it. When unset during `astro dev`, links fall back to http://localhost:5173/.
# Production build (`astro build`): uses https://demo.formengine.io/ unless DEMO_URL is set.
#
# Examples:
#   DEMO_URL=http://localhost:5173
#   DEMO_URL=https://demo.formengine.io

# Algolia DocSearch (standalone Form Author Guide index).
# Defaults from docsearch.config.json in this directory.
# Examples:
#   DOCSEARCH_APP_ID=BSTQ9Y9FKD
#   DOCSEARCH_API_KEY=your-search-only-api-key
#   DOCSEARCH_INDEX_NAME=FormEngine Form Author Guide
#
# Optional: restrict hits to a pathname prefix when sharing the developer-docs index:
#   DOCSEARCH_PATH_PREFIX=/
