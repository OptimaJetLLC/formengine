# Local FormEngine demo (Vite default for packages/apps/demo).
# Loaded automatically during `astro dev`; not used for `astro build`.
DEMO_URL=https://demo.formengine.io/

# Same-origin developer docs via formengine.local / reverse proxy during `astro dev`.
# Production builds default to https://formengine.io/documentation/ when unset.
# MAIN_DOCS_URL=http://localhost:3000/documentation/
MAIN_DOCS_URL=http://formengine.local/documentation/
