{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "docsearch.config.json"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "public"
  ]
}
