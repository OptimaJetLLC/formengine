{
  "version": "1",
  "errorType": "RsErrorMessage",
  "form": {
    "key": "screen1",
    "type": "Screen",
    "props": {},
    "children": [
      {
        "key": "formTitle",
        "type": "RsHeader",
        "props": {
          "content": {
            "value": "Employee onboarding"
          },
          "headerSize": {
            "value": "h4"
          }
        }
      },
      {
        "key": "onboardingTabs",
        "type": "RsTab",
        "props": {
          "activeKey": {
            "value": "Profile"
          },
          "items": {
            "value": [
              {
                "label": "Profile",
                "value": "Profile"
              },
              {
                "label": "Job details",
                "value": "Job details"
              },
              {
                "label": "Documents",
                "value": "Documents"
              }
            ]
          }
        },
        "children": [
          {
            "key": "profilePane",
            "type": "RsContainer",
            "props": {},
            "slot": "pane",
            "slotCondition": "return parentProps.activeKey === 'Profile'",
            "children": [
              {
                "key": "fullName",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Full name"
                  }
                }
              },
              {
                "key": "workEmail",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Work email"
                  }
                }
              },
              {
                "key": "phone",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Phone"
                  }
                }
              }
            ]
          },
          {
            "key": "jobPane",
            "type": "RsContainer",
            "props": {},
            "slot": "pane",
            "slotCondition": "return parentProps.activeKey === 'Job details'",
            "children": [
              {
                "key": "department",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Department"
                  }
                }
              },
              {
                "key": "startDate",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Start date"
                  }
                }
              },
              {
                "key": "manager",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "Manager"
                  }
                }
              }
            ]
          },
          {
            "key": "documentsPane",
            "type": "RsContainer",
            "props": {},
            "slot": "pane",
            "slotCondition": "return parentProps.activeKey === 'Documents'",
            "children": [
              {
                "key": "idDocument",
                "type": "RsInput",
                "props": {
                  "label": {
                    "value": "ID document number"
                  }
                }
              },
              {
                "key": "contractSigned",
                "type": "RsCheckbox",
                "props": {
                  "children": {
                    "value": "Employment contract signed"
                  }
                }
              },
              {
                "key": "submitOnboarding",
                "type": "RsButton",
                "props": {
                  "children": {
                    "value": "Submit onboarding"
                  },
                  "appearance": {
                    "value": "primary"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
