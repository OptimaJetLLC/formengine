{
  "name": "@react-form-builder/designer-guide",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:navigation": "node scripts/build-navigation.mjs",
    "optimize:images": "node scripts/optimize-guide-images.mjs",
    "catalog:screenshots": "node ./scripts/run-formbuilder-end-user-docs.mjs build-guide-screenshot-catalog.mjs",
    "catalog:screenshots:check": "node ./scripts/run-formbuilder-end-user-docs.mjs build-guide-screenshot-catalog.mjs --check",
    "clean": "node scripts/clean.mjs",
    "inject:demo-links": "node scripts/inject-demo-links.mjs",
    "check:all": "npm run check:links && npm run check:tsc && npm run check:eslint && npm run check:stylelint",
    "check:links": "node scripts/check-links.mjs",
    "check:tsc": "npm run build:navigation && tsc --noEmit",
    "check:eslint": "eslint .",
    "check:stylelint": "stylelint \"src/**/*.css\"",
    "stylelint-fix": "stylelint \"src/**/*.css\" --fix",
    "dev": "npm run build:navigation && astro dev",
    "build": "npm run optimize:images && npm run build:navigation && rm -rf .astro node_modules/.astro && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.1.5",
    "@docsearch/css": "^5.2.0",
    "@docsearch/js": "^5.2.0",
    "astro": "^7.4.11",
    "cookie": "2.0.2",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "5.9.3"
  },
  "license": "https://formengine.io/eula/"
}
