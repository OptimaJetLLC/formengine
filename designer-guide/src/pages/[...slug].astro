---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import SectionToc from '../components/SectionToc.astro';
import { isSectionIndexEntry, navSlugFromEntryId } from '../utils/site-url';

export async function getStaticPaths() {
  const entries = await getCollection('docs');

  return entries
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: navSlugFromEntryId(entry.id) },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const navSlug = navSlugFromEntryId(entry.id);
const currentPath = `/${navSlug}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentPath={currentPath}
  entryId={navSlug}
  headings={headings}
>
  <Content />
  {isSectionIndexEntry(entry.id) && <SectionToc sectionSlug={navSlug} />}
</DocsLayout>
