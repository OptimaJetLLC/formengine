---
import {
  docsearchConfig,
  docsearchEnabled,
  docsearchPathPrefix,
} from '../constants/docsearch-config.mjs';
---

{docsearchEnabled && (
  <div
    id="docsearch"
    class="fe-docsearch"
    data-app-id={docsearchConfig.appId}
    data-api-key={docsearchConfig.apiKey}
    data-index-name={docsearchConfig.indexName}
    data-path-prefix={docsearchPathPrefix}
  />
)}

    <script>
      import docsearch from '@docsearch/js/docsearch'
      import type {DocSearchInstance, DocSearchProps} from '@docsearch/js/docsearch'

      type DocSearchItems = Parameters<NonNullable<DocSearchProps['transformItems']>>[0]

      let instance: DocSearchInstance | null = null
      let activeContainer: HTMLElement | null = null

      function initDocSearch(): void {
        const container = document.querySelector<HTMLElement>('#docsearch')
        if (!container || container === activeContainer) {
          return
        }
        const {appId, apiKey, indexName, pathPrefix} = container.dataset
        if (!appId || !apiKey || !indexName) {
          return
        }

        const options: DocSearchProps = {
          container,
          appId,
          apiKey,
          indices: [indexName],
          placeholder: 'Search docs…',
        }

        if (pathPrefix) {
          const pathPrefixWithSlash = pathPrefix.endsWith('/') ? pathPrefix : `${pathPrefix}/`
          options.transformItems = (items: DocSearchItems): DocSearchItems =>
            items.filter(({url}) => {
              try {
                const pathname = new URL(url, window.location.origin).pathname
                return pathname === pathPrefix || pathname.startsWith(pathPrefixWithSlash)
              } catch {
                return url.includes(pathPrefix)
              }
            })
        }

        instance?.destroy()
        instance = docsearch(options)
        activeContainer = container
      }

      initDocSearch()
      document.addEventListener('astro:page-load', initDocSearch)
    </script>
