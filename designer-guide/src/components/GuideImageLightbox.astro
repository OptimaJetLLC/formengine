---
---
<dialog
  id="fe-guide-image-lightbox"
  class="fe-guide-image-lightbox"
  aria-label="Screenshot preview"
  data-astro-transition-persist="guide-image-lightbox"
>
  <div class="fe-guide-image-lightbox__frame">
    <button
      id="fe-guide-image-lightbox-close"
      class="fe-guide-image-lightbox__close"
      type="button"
      aria-label="Close screenshot preview"
    >
      <svg class="fe-guide-image-lightbox__close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <img id="fe-guide-image-lightbox-img" class="fe-guide-image-lightbox__image" alt="" width="1200" height="800" />
  </div>
</dialog>
