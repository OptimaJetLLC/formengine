{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "FE-2441: disable intentional major bumps from Dependabot PR #2488. examples/** are left enabled.",
  "packageRules": [
    {
      "description": "React 18 host — keep react/react-dom/types on 18 (tests/react-18).",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "matchUpdateTypes": ["major"],
      "matchFileNames": ["tests/react-18/package.json"],
      "enabled": false
    },
    {
      "description": "Published bundles — peer floor is React 18 (^18.2.0); do not auto-major to 19.",
      "matchPackageNames": ["react", "react-dom", "react-is"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [
        "packages/designer-bundle/package.json",
        "packages/viewer-bundle/package.json",
        "packages/viewer-bundle-premium/package.json"
      ],
      "enabled": false
    },
    {
      "description": "react-is peer range on Material UI view package.",
      "matchPackageNames": ["react-is"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": ["packages/views/material-ui/package.json"],
      "enabled": false
    },
    {
      "description": "TypeScript pinned at 5.8.3 in monorepo toolchain / docs / guide.",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [
        "package.json",
        "designer-guide/package.json",
        "documentation/website/package.json"
      ],
      "enabled": false
    },
    {
      "description": "date-fns v2 pin (RSuite date peers).",
      "matchPackageNames": ["date-fns"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [
        "packages/designer/package.json",
        "packages/views/rsuite/package.json"
      ],
      "enabled": false
    },
    {
      "description": "RSuite v5 pin across apps, designer, docs, views, and shared tests.",
      "matchPackageNames": ["rsuite"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [
        "documentation/website/package.json",
        "packages/apps/common-designer/package.json",
        "packages/apps/csp-builder/package.json",
        "packages/apps/csp-viewer/package.json",
        "packages/apps/demo/package.json",
        "packages/apps/example-builder/package.json",
        "packages/apps/example-viewer/package.json",
        "packages/apps/formbuilder/package.json",
        "packages/designer/package.json",
        "packages/views/rsuite/package.json",
        "packages/views/rsuite-table/package.json",
        "tests/common/package.json"
      ],
      "enabled": false
    },
    {
      "description": "Mantine v8 pin (component library + host apps).",
      "matchPackageNames": ["@mantine/*"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": [
        "packages/views/mantine/package.json",
        "packages/apps/common-designer/package.json",
        "packages/apps/example-viewer/package.json"
      ],
      "enabled": false
    },
    {
      "description": "skia-canvas v3 pin in component tests.",
      "matchPackageNames": ["skia-canvas"],
      "matchUpdateTypes": ["major"],
      "matchFileNames": ["tests/component/package.json"],
      "enabled": false
    }
  ]
}
